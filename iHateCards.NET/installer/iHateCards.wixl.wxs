<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI-установщик iHateCards. Собирается нативно на macOS/Linux через msitools
  (brew install msitools), а также совместим с WiX v3 на Windows.

  Полная сборка: installer/build-installer.sh
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="iHateCards"
           Language="1049"
           Codepage="1251"
           Version="1.0.0"
           Manufacturer="iHatePDF"
           UpgradeCode="7C4E9A62-1B33-4F5E-9E21-0A8D6C5B2F41">

    <!-- perUser: установка в папку пользователя. Именно поэтому программа умеет
         обновляться сама, не запрашивая прав администратора. -->
    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perUser"
             InstallPrivileges="limited"
             Manufacturer="iHatePDF"
             Description="iHateCards — раскладка карт для печати (CMYK SWOP)"
             Comments="iHateCards 1.0" />

    <Media Id="1" Cabinet="ihatecards.cab" EmbedCab="yes" />

    <Icon Id="AppIcon.exe" SourceFile="../src/iHateCards/Assets/app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://ihatepdf.ru/" />

    <Property Id="MSIINSTALLPERUSER" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <!-- %LOCALAPPDATA%\Programs\iHateCards — папка пользователя, доступная на запись -->
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLDIR" Name="iHateCards" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuDir" Name="iHateCards" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <!-- Ассоциация .hate: двойной клик открывает проект в приложении -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="FileAssociation" Guid="B1C0F5E4-9D2A-4C77-8E3B-5F6A1D9E4C22">
        <RegistryValue Root="HKCU" Key="Software\Classes\.hate" Type="string" Value="iHateCards.Project" />
        <RegistryValue Root="HKCU" Key="Software\Classes\iHateCards.Project" Type="string" Value="Проект iHateCards" />
        <RegistryValue Root="HKCU" Key="Software\Classes\iHateCards.Project\DefaultIcon" Type="string"
                       Value="[INSTALLDIR]iHateCards.exe,0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\iHateCards.Project\shell\open\command" Type="string"
                       Value="&quot;[INSTALLDIR]iHateCards.exe&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKCU" Key="Software\iHatePDF\iHateCards" Name="InstallDir"
                       Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="AppMenuDir">
      <Component Id="StartMenuShortcut" Guid="2E8B7A16-4F0C-49D3-B7A5-3C1E8D0F6B93">
        <Shortcut Id="StartMenuLink"
                  Name="iHateCards"
                  Description="Раскладка карт для печати (CMYK SWOP)"
                  Target="[INSTALLDIR]iHateCards.exe"
                  WorkingDirectory="INSTALLDIR"
                  Icon="AppIcon.exe" />
        <RemoveFolder Id="RemoveAppMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\iHatePDF\iHateCards" Name="StartMenu"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="9A3D5C18-6E24-4B8F-A0D1-7B2F4E6C8A05">
        <Shortcut Id="DesktopLink"
                  Name="iHateCards"
                  Target="[INSTALLDIR]iHateCards.exe"
                  WorkingDirectory="INSTALLDIR"
                  Icon="AppIcon.exe" />
        <RegistryValue Root="HKCU" Key="Software\iHatePDF\iHateCards" Name="Desktop"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="iHateCards" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="FileAssociation" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Product>
</Wix>
